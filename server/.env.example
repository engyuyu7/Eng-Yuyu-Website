# Copy to server/.env and fill in (never commit .env)

# --- Google (calendar + Meet + emails) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Optional: more calendar IDs whose busy times should also block slots (comma separated)
GOOGLE_EXTRA_CALENDARS=
# The Gmail address you authorised (emails are sent From it) and where "new paid booking" alerts go
OWNER_EMAIL=

# --- Sifalo Pay ---
# Set the mode and the API keys in Dashboard → Settings → Payments (off / test / sandbox / live). Keys saved there are
# stored encrypted. Set PAYMENT_SECRET to a long random string so that encryption key lives outside the data folder.
PAYMENT_SECRET=
# Optional, older setups: live keys here are used until you save live keys in the dashboard.
SIFALO_API_USER=
SIFALO_API_KEY=

# --- Dashboard (https://YOUR-API/admin) ---
# Choose a long, unique password. Without it the dashboard is disabled.
ADMIN_PASSWORD=
# At least 12 characters (the dashboard stays off if it is shorter). A long passphrase of 4+ random words is ideal.
# Set to 1 when the API is served over https so the login cookie is marked Secure
SECURE_COOKIES=
# Set to 1 when the app sits behind a reverse proxy / platform load balancer (Render, Fly, Railway, Nginx…) so rate limits and
# the Secure flag use the visitor's real address. Leave empty if Node is exposed directly.
TRUST_PROXY=
# Public URL of this API (used in newsletter unsubscribe links)
PUBLIC_API_URL=
# Where data files live (default server/data). On a host with a persistent disk, point this at it.
DATA_DIR=

# --- Supabase (data + uploads) ---
# Leave both empty to keep everything in local files (server/data). With both set, all data is saved in Supabase and
# pictures/videos go to the "uploads" bucket. Run docs/supabase-setup.sql in Supabase first.
# SUPABASE_SERVICE_KEY is a SECRET: set it only on the server or the host, never in the website code or Git.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optional: another storage bucket name (default uploads)
SUPABASE_BUCKET=

# --- URLs ---
# Your website (Sifalo sends clients back to SITE_URL/consulting.html after paying)
SITE_URL=https://engyuyu.com
# Allowed browser origin(s), comma separated
ALLOWED_ORIGIN=https://engyuyu.com
PORT=8787

# Local testing without Google/Sifalo:  MOCK=1  (add MOCK_PAYMENT=0 to test the no-payment path)
